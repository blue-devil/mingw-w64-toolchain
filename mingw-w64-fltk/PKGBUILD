# Maintainer: Emanuele Giacomelli <manu-archlinux@altmails.com>
# Contributor: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

pkgname=mingw-w64-fltk
_pkgname=fltk
pkgdesc="Graphical user interface toolkit (mingw-w64)"
pkgver=1.3.11
pkgrel=1
arch=('any')
license=('LGPL-2.0-only WITH FLTK-exception')
url="https://www.fltk.org/"
depends=('mingw-w64-libjpeg-turbo' 'mingw-w64-libpng' 'mingw-w64-zlib' 'mingw-w64-crt' 'bash')
makedepends=('mingw-w64-configure')
source=("https://github.com/fltk/fltk/releases/download/release-${pkgver}/fltk-${pkgver}-source.tar.gz"
        subdirs.patch)
sha256sums=('92805abc84505e3e7e27aec775ab0754ecb4182fe2d8ff2a9d568ccdcb2811ac'
            '42969ffc180257ab6301c241a3b0a8e605e5420e7b6b8a434e821479491badf9')
options=('!docs' '!strip' '!buildflags' 'staticlibs')

# Windows targets to build. aarch64-w64-mingw32 is experimental (see README.EN.md).
_targets="${MINGW_W64_TARGETS:-i686-w64-mingw32 x86_64-w64-mingw32}"

prepare() {
  cd ${_pkgname}-${pkgver}
  patch -p1 -i ../subdirs.patch
  sed -i 's/class Fl_XFont_On_Demand/class FL_EXPORT Fl_XFont_On_Demand/' FL/x.H
  sed -i 's/x-fluid.desktop/fluid.desktop/' -i fluid/Makefile
}

build() {
  cd ${_pkgname}-${pkgver}
  sed -i -e 's/$(LINKFLTK)/$(LINKSHARED)/' \
         -e 's/$(LINKFLTKIMG)/$(LINKSHARED)/' test/Makefile
  for _target in ${_targets}; do
    cp -a "$srcdir/${_pkgname}-${pkgver}" "$srcdir/build-${_target}"
    cd "$srcdir/build-${_target}"
    local _ldflags="$(source mingw-env "${_target}" && echo "$LDFLAGS")"
    DSOFLAGS="$_ldflags" \
      "${_target}"-configure --prefix=/usr/"${_target}" --enable-threads \
        --enable-shared .
    make
  done
}

package() {
  for _target in ${_targets}; do
    cd "$srcdir/build-${_target}"
    make DESTDIR="$pkgdir" install
    chmod 0644 "$pkgdir/usr/${_target}/lib"/*.a
    install -d "$pkgdir/usr/bin"
    ln -sf "../${_target}/bin/fltk-config" "$pkgdir/usr/bin/${_target}-fltk-config"
    ${_target}-strip --strip-unneeded "$pkgdir"/usr/${_target}/bin/*.dll
    ${_target}-strip -g "$pkgdir"/usr/${_target}/lib/*.a
  done
  cd "$srcdir/${_pkgname}-${pkgver}"
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}

