# Contributor: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

pkgname=mingw-w64-crt
pkgver=14.0.0
pkgrel=1
pkgdesc='MinGW-w64 CRT for Windows'
arch=('any')
url='https://www.mingw-w64.org'
license=('LicenseRef-custom')
groups=('mingw-w64-toolchain' 'mingw-w64')
# mingw-w64-gcc-base is satisfied by the stage-1 bootstrap compiler and later
# by mingw-w64-gcc (provides); mingw-w64-headers-bootstrap by the bootstrap
# package and later by mingw-w64-winpthreads (provides). Rebuilds after the
# bootstrap therefore need no edits.
makedepends=('mingw-w64-gcc-base' 'mingw-w64-binutils' "mingw-w64-headers=${pkgver}" 'mingw-w64-headers-bootstrap')
options=('!strip' '!buildflags' 'staticlibs' '!emptydirs')
validpgpkeys=('CAF5641F74F7DFBA88AE205693BDB53CD4EBC740') # JonY <jon_y@users.sourceforge.net>
source=(https://sourceforge.net/projects/mingw-w64/files/mingw-w64/mingw-w64-release/mingw-w64-v${pkgver}.tar.bz2{,.sig})
sha512sums=('17378a0e2abbbb688468a78cb0ba261f9001a1bc6e7d0270c24c4b8b13e5c6513e8fb8e617d08102fbc772c288ad81ec3a43ca756ed28f17cc5543f717a8bb6d'
            'SKIP')

# Windows targets to build. aarch64-w64-mingw32 is experimental (see README.EN.md).
_targets="${MINGW_W64_TARGETS:-i686-w64-mingw32 x86_64-w64-mingw32}"

build() {
  cd "$srcdir"
  for _target in ${_targets}; do
    echo "Building ${_target} CRT"
    case ${_target} in
      i686-w64-mingw32)
        _crt_configure_args="--disable-lib64 --enable-lib32" ;;
      x86_64-w64-mingw32)
        _crt_configure_args="--disable-lib32 --enable-lib64" ;;
      aarch64-w64-mingw32)
        # experimental: GCC 15/16 support C/C++ without C++ exceptions
        _crt_configure_args="--disable-lib32 --disable-lib64 --enable-libarm64" ;;
      *)
        echo "Unsupported target ${_target}" >&2
        return 1 ;;
    esac
    mkdir -p "$srcdir"/crt-${_target} && cd "$srcdir"/crt-${_target}
    # --with-default-msvcrt is left at the mingw-w64 14 default (ucrt), as Arch does
    "$srcdir"/mingw-w64-v${pkgver}/mingw-w64-crt/configure --prefix=/usr/${_target} \
        --host=${_target} --enable-wildcard \
        ${_crt_configure_args}
    make
  done
}

package() {
  for _target in ${_targets}; do
    echo "Installing ${_target} crt"
    cd "$srcdir"/crt-${_target}
    make DESTDIR="$pkgdir" install
  done
  # Licenses
  install -Dm644 "$srcdir"/mingw-w64-v${pkgver}/COPYING.MinGW-w64/COPYING.MinGW-w64.txt "$pkgdir"/usr/share/licenses/${pkgname}/COPYING.MinGW-w64.txt
  install -Dm644 "$srcdir"/mingw-w64-v${pkgver}/COPYING.MinGW-w64-runtime/COPYING.MinGW-w64-runtime.txt "$pkgdir"/usr/share/licenses/${pkgname}/COPYING.MinGW-w64-runtime.txt
  install -Dm644 "$srcdir"/mingw-w64-v${pkgver}/mingw-w64-headers/ddk/readme.txt "$pkgdir"/usr/share/licenses/${pkgname}/ddk-readme.txt
}

