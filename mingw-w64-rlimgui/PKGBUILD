# Maintainer: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

pkgname=mingw-w64-rlimgui
pkgver=6.0
_tag=Raylib_6_0
pkgrel=1
pkgdesc="Dear ImGui backend for raylib, as a static library (mingw-w64)"
arch=('any')
url="https://github.com/raylib-extras/rlImGui"
license=('Zlib')
depends=('mingw-w64-imgui' 'mingw-w64-raylib')
makedepends=('mingw-w64-gcc' 'mingw-w64-pkg-config')
options=('!buildflags' 'staticlibs' '!strip')
source=("rlImGui-${_tag}.tar.gz::https://github.com/raylib-extras/rlImGui/archive/refs/tags/${_tag}.tar.gz")
sha256sums=('2d2385f42595ca1f5fd10434c1d34b4392994ba28105454ab88bc808a9bafd33')

# Windows targets to build. aarch64-w64-mingw32 is experimental (see README.EN.md).
_targets="${MINGW_W64_TARGETS:-i686-w64-mingw32 x86_64-w64-mingw32}"

build() {
  cd "rlImGui-${_tag}"
  for _target in ${_targets}; do
    mkdir -p "${srcdir}/build-${_target}"
    ${_target}-g++ -O2 -std=c++17 -I. $(${_target}-pkg-config --cflags imgui raylib) \
      -c rlImGui.cpp -o "${srcdir}/build-${_target}/rlImGui.o"
    ${_target}-ar rcs "${srcdir}/build-${_target}/librlImGui.a" "${srcdir}/build-${_target}/rlImGui.o"
  done
}

package() {
  cd "rlImGui-${_tag}"
  for _target in ${_targets}; do
    local _prefix="${pkgdir}/usr/${_target}"
    install -d "${_prefix}/include/extras" "${_prefix}/lib/pkgconfig"
    install -m644 rlImGui.h rlImGuiColors.h imgui_impl_raylib.h "${_prefix}/include/"
    install -m644 extras/IconsFontAwesome6.h extras/FA6FreeSolidFontData.h "${_prefix}/include/extras/"
    install -m644 "${srcdir}/build-${_target}/librlImGui.a" "${_prefix}/lib/"
    ${_target}-strip -g "${_prefix}/lib/librlImGui.a"
    cat > "${_prefix}/lib/pkgconfig/rlImGui.pc" <<EOF
prefix=/usr/${_target}
libdir=\${prefix}/lib
includedir=\${prefix}/include

Name: rlImGui
Description: Dear ImGui backend for raylib (static)
Version: ${pkgver}
Requires: imgui raylib
Cflags: -I\${includedir}
Libs: -L\${libdir} -lrlImGui
EOF
  done
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 extras/FontAwsome_LICENSE.txt "${pkgdir}/usr/share/licenses/${pkgname}/FontAwesome_LICENSE.txt"
}

