# Contributor: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_pkgname=xz

pkgname=mingw-w64-xz
pkgver=5.8.3
pkgrel=1
pkgdesc="Library and command line tools for XZ and LZMA compressed files (mingw-w64)"
arch=('any')
url="https://tukaani.org/xz/"
license=("GPL-2.0-or-later AND 0BSD AND LicenseRef-Public-Domain AND LGPL-2.1-or-later")
depends=('mingw-w64-crt')
makedepends=('mingw-w64-configure')
options=('!strip' 'staticlibs' '!buildflags')
validpgpkeys=('3690C240CE51B4670D30AD1C38EE757D69184620') # Lasse Collin <lasse.collin@tukaani.org>
source=("https://github.com/tukaani-project/xz/releases/download/v${pkgver}/xz-${pkgver}.tar.xz"{,.sig})
sha256sums=('fff1ffcf2b0da84d308a14de513a1aa23d4e9aa3464d17e64b9714bfdd0bbfb6'
            'SKIP')

# Windows targets to build. aarch64-w64-mingw32 is experimental (see README.EN.md).
_targets="${MINGW_W64_TARGETS:-i686-w64-mingw32 x86_64-w64-mingw32}"

build() {
  cd "${srcdir}/${_pkgname}-${pkgver}"
  for _target in ${_targets}; do
    mkdir -p build-${_target} && pushd build-${_target}
    ${_target}-configure \
       --disable-nls \
       --disable-doc
    make
    popd
  done
}

package() {
  for _target in ${_targets}; do
    cd "${srcdir}/${_pkgname}-${pkgver}/build-${_target}"
    make DESTDIR="${pkgdir}" install
    find "${pkgdir}/usr/${_target}" -name '*.exe' | xargs -rtl1 rm
    find "${pkgdir}/usr/${_target}" -name '*.dll' | xargs -rtl1 ${_target}-strip -x
    find "${pkgdir}/usr/${_target}" -name '*.a' -o -name '*.dll' | xargs -rtl1 ${_target}-strip -g
    rm -f "${pkgdir}/usr/${_target}/bin/"{lz{cmp,diff,egrep,fgrep,grep,less,more},xz{cmp,diff,egrep,fgrep,grep,less,more}}
    rm -rf "${pkgdir}/usr/${_target}/share"
  done
  install -Dm644 "${srcdir}/${_pkgname}-${pkgver}/COPYING" "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}

