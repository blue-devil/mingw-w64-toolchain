# Maintainer: xantares
# Contributor: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

pkgname=mingw-w64-libgnurx
pkgver=2.5.1
pkgrel=6
pkgdesc="regex functionality from glibc (mingw-w64)"
arch=('any')
url="https://sourceforge.net/projects/mingw/"
license=('LGPL-2.1-or-later')
depends=('mingw-w64-crt')
makedepends=('mingw-w64-configure')
provides=('mingw-w64-regex')
conflicts=('mingw-w64-regex')
options=('!buildflags' '!strip' 'staticlibs')
source=("https://download.sourceforge.net/mingw/Other/UserContributed/regex/mingw-regex-${pkgver}/mingw-libgnurx-${pkgver}-src.tar.gz"
        mingw-w64-libgnurx-honor-destdir.patch
        stdbool.patch)
sha256sums=('7147b7f806ec3d007843b38e19f42a5b7c65894a57ffc297a76b0dcd5f675d76'
            '7db74e71a2612e1720f68acea7c9bc24873be1d533c1eed4db58c4fd923e1ec1'
            '101add52fa902a99fef470bd6cba26d39eb0a67f59db7706ff710036dcb968c6')

# Windows targets to build. aarch64-w64-mingw32 is experimental (see README.EN.md).
_targets="${MINGW_W64_TARGETS:-i686-w64-mingw32 x86_64-w64-mingw32}"

prepare() {
  cd "$srcdir/mingw-libgnurx-${pkgver}"
  patch -Np0 -i ../mingw-w64-libgnurx-honor-destdir.patch
  patch -p0 -i ../stdbool.patch
}

build() {
  cd "$srcdir/mingw-libgnurx-${pkgver}"
  for _target in ${_targets}; do
    mkdir -p build-${_target} && pushd build-${_target}
    ${_target}-configure
    make
    popd
  done
}

package() {
  for _target in ${_targets}; do
    cd "$srcdir/mingw-libgnurx-${pkgver}/build-${_target}"
    install -d "$pkgdir"/usr/${_target}/include
    make install DESTDIR="$pkgdir"
    ${_target}-strip --strip-unneeded "$pkgdir"/usr/${_target}/bin/*.dll
    ${_target}-strip -g "$pkgdir"/usr/${_target}/lib/*.a
    rm -r "$pkgdir"/usr/${_target}/man
  done
}

