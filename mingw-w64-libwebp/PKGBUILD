# Contributor: drakkan <nicola.murino at gmail dot com>
# Contributor: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_pkgname=libwebp
pkgname=mingw-w64-${_pkgname}
pkgver=1.6.0
pkgrel=2
pkgdesc="WebP library and conversion tools (mingw-w64)"
arch=('any')
url="https://developers.google.com/speed/webp/"
license=('BSD-3-Clause')
makedepends=('mingw-w64-cmake' 'ninja')
depends=('mingw-w64-crt')
options=('staticlibs' '!strip' '!buildflags')
source=("https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-$pkgver.tar.gz"{,.asc})
sha256sums=('e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564'
            'SKIP')
validpgpkeys=('6B0E6B70976DE303EDF2F601F9C3D6BDB8232B5D') # WebP release signing key

_srcdir="${_pkgname}-${pkgver}"
# Windows targets to build. aarch64-w64-mingw32 is experimental (see README.EN.md).
_targets="${MINGW_W64_TARGETS:-i686-w64-mingw32 x86_64-w64-mingw32}"
_flags=(
  -Wno-dev -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS_RELEASE='-DNDEBUG'
  -DWEBP_ENABLE_SWAP_16BIT_CSP=ON )

build() {
  for _target in ${_targets}; do
    ${_target}-cmake -G Ninja -S "${_srcdir}" -B "build-${_target}-static" "${_flags[@]}" \
      -DBUILD_SHARED_LIBS=OFF \
      -DCMAKE_INSTALL_PREFIX="/usr/${_target}/static" \
      -DCMAKE_FIND_NO_INSTALL_PREFIX=ON
    cmake --build "build-${_target}-static"

    ${_target}-cmake -G Ninja -S "${_srcdir}" -B "build-${_target}" "${_flags[@]}"
    cmake --build "build-${_target}"
  done
}

package() {
  for _target in ${_targets}; do
    DESTDIR="${pkgdir}" cmake --install "build-${_target}-static"
    rm -rf "$pkgdir"/usr/${_target}/static/share
    ${_target}-strip -g "$pkgdir"/usr/${_target}/static/lib/*.a

    DESTDIR="${pkgdir}" cmake --install "build-${_target}"
    ${_target}-strip "$pkgdir"/usr/${_target}/bin/*.exe
    ${_target}-strip --strip-unneeded "$pkgdir"/usr/${_target}/bin/*.dll
    ${_target}-strip -g "$pkgdir"/usr/${_target}/lib/*.a
  done
  install -Dm644 "${srcdir}/${_srcdir}/COPYING" "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}

