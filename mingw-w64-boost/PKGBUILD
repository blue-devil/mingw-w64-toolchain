# Maintainer: xantares
# Contributor: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

pkgname=mingw-w64-boost
pkgver=1.92.0
_boostver=${pkgver//./_}
pkgrel=2
pkgdesc="Free peer-reviewed portable C++ source libraries (mingw-w64)"
arch=('any')
url="https://www.boost.org/"
license=('BSL-1.0')
depends=('mingw-w64-zlib' 'mingw-w64-zstd' 'mingw-w64-bzip2')
makedepends=('mingw-w64-gcc' 'mingw-w64-environment')
options=('!strip' '!buildflags' 'staticlibs')
source=("https://archives.boost.io/release/${pkgver}/source/boost_${_boostver}.tar.bz2"
        "cobalt-cba2768.patch")
sha256sums=('5c1d40cb8e19adbf740a4ec2da35b3e58f3f5804b1dce44deb53df72193cbc6c'
            'fa8f535edfa0b51518b41f72293d8a998779bf640918abd74ebaa4cb474fd4e8')

# Windows targets to build. aarch64-w64-mingw32 is experimental (see README.EN.md).
_targets="${MINGW_W64_TARGETS:-i686-w64-mingw32 x86_64-w64-mingw32}"

prepare() {
  # Boost.Cobalt: link ws2_32 with gcc on Windows (upstream commit cba2768)
  patch -p1 -d "boost_${_boostver}/libs/cobalt" -i "${srcdir}/cobalt-cba2768.patch"

  for _target in ${_targets}; do
    source mingw-env "${_target}"
    rm -rf "build-${_target}"
    cp -r "boost_${_boostver}" "build-${_target}"
    pushd "build-${_target}"
    cat > user-config.jam <<EOF
using gcc : mingw64 : ${CXX}
        :
        <rc>${_target}-windres
        <archiver>${_target}-ar
;
EOF
    ./bootstrap.sh --with-toolset=gcc
    popd
  done
}

package() {
  cd "${srcdir}"
  for _target in ${_targets}; do
    source mingw-env "${_target}"
    local _bits=64
    [[ ${_target} == i686-w64-mingw32 ]] && _bits=32
    pushd "build-${_target}"
    LD_PRELOAD="" ./b2 -d2 -q ${MAKEFLAGS} \
      target-os=windows \
      variant=release \
      threading=multi \
      threadapi=win32 \
      link=shared,static \
      runtime-link=shared \
      --prefix="${pkgdir}/usr/${_target}" \
      --user-config=user-config.jam \
      --without-python --without-mpi --without-graph_parallel \
      cxxflags="${CXXFLAGS}" \
      linkflags="${LDFLAGS}" \
      address-model=${_bits} \
      architecture=x86 \
      binary-format=pe \
      abi=ms \
      -l0 \
      --layout=system install
    install -d "${pkgdir}/usr/${_target}/bin"
    ${_target}-strip --strip-unneeded "${pkgdir}"/usr/${_target}/bin/*.dll
    ${_target}-strip -g "${pkgdir}"/usr/${_target}/lib/*.a
    popd
  done
  install -Dm644 "boost_${_boostver}/LICENSE_1_0.txt" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE_1_0.txt"
}

