# Contributor: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

pkgname=mingw-w64-libpng
pkgver=1.6.59
pkgrel=1
arch=('any')
pkgdesc="A collection of routines used to create PNG format graphics (mingw-w64)"
depends=('mingw-w64-zlib')
makedepends=('mingw-w64-configure')
license=('libpng-2.0')
url="http://www.libpng.org/pub/png/libpng.html"
options=('!strip' '!buildflags' 'staticlibs')
source=("https://downloads.sourceforge.net/sourceforge/libpng/libpng-$pkgver.tar.xz")
sha256sums=('d80dd2a38a37f803cb9b6ac7b14bd6e74ddc3b654780a8380bdf93523fdb4389')

# Windows targets to build. aarch64-w64-mingw32 is experimental (see README.EN.md).
_targets="${MINGW_W64_TARGETS:-i686-w64-mingw32 x86_64-w64-mingw32}"

build() {
  cd "$srcdir/libpng-$pkgver"
  for _target in ${_targets}; do
    mkdir -p build-${_target} && pushd build-${_target}
    ${_target}-configure
    make
    popd
  done
}

package() {
  for _target in ${_targets}; do
    cd "${srcdir}/libpng-${pkgver}/build-${_target}"
    make install DESTDIR="${pkgdir}"
    rm -r "${pkgdir}"/usr/${_target}/share
    rm "${pkgdir}"/usr/${_target}/bin/*.exe
    ${_target}-strip --strip-unneeded "${pkgdir}"/usr/${_target}/bin/*.dll
    ${_target}-strip -g "${pkgdir}"/usr/${_target}/lib/*.a
  done
  install -Dm644 "$srcdir/libpng-$pkgver/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

