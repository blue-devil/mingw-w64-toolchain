# Maintainer: edub4rt
# Contributor: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

pkgname=mingw-w64-sdl2
pkgver=2.32.10
pkgrel=1
pkgdesc='A library for portable low-level access to a video framebuffer, audio output, mouse, and keyboard (Version 2) (mingw-w64)'
license=('Zlib')
url='https://libsdl.org'
arch=('any')
depends=('mingw-w64-crt' 'sh')
makedepends=('mingw-w64-configure')
source=("https://github.com/libsdl-org/SDL/releases/download/release-${pkgver}/SDL2-${pkgver}.tar.gz"{,.sig})
sha256sums=('5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165'
            'SKIP')
validpgpkeys=('1528635D8053A57F77D1E08630A59377A7763BE6') # Sam Lantinga <slouken@libsdl.org>
options=('!debug' '!buildflags' 'staticlibs' '!strip')

# Windows targets to build. aarch64-w64-mingw32 is experimental (see README.EN.md).
_targets="${MINGW_W64_TARGETS:-i686-w64-mingw32 x86_64-w64-mingw32}"

build() {
  export MINGW_LDFLAGS="-s"
  cd "${srcdir}/SDL2-${pkgver}"
  for _target in ${_targets}; do
    mkdir -p build-${_target} && pushd build-${_target}
    ${_target}-configure
    make
    popd
  done
}

package() {
  cd "${srcdir}/SDL2-${pkgver}"
  install -d "${pkgdir}"/usr/bin
  for _target in ${_targets}; do
    pushd build-${_target}
    make DESTDIR="${pkgdir}" install
    find "${pkgdir}/usr/${_target}/bin" -name "*.dll" -exec ${_target}-strip --strip-unneeded {} \;
    find "${pkgdir}/usr/${_target}/lib" -name "*.a" -exec ${_target}-strip -g {} \;
    cp "${pkgdir}/usr/${_target}/lib/libSDL2.a" "${pkgdir}/usr/${_target}/lib/libSDL2-static.a"
    ln -s "/usr/${_target}/bin/sdl2-config" "${pkgdir}/usr/bin/${_target}-sdl2-config"
    popd
  done
  install -Dm644 LICENSE.txt "${pkgdir}/usr/share/licenses/$pkgname/LICENSE"
}

