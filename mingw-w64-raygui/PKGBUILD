# Maintainer: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

pkgname=mingw-w64-raygui
pkgver=5.0
pkgrel=1
pkgdesc="Simple and easy-to-use immediate-mode GUI library for raylib, header only (mingw-w64)"
arch=('any')
url="https://github.com/raysan5/raygui"
license=('Zlib')
depends=('mingw-w64-raylib')
source=("raygui-${pkgver}.tar.gz::https://github.com/raysan5/raygui/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('0f194c4a5e837c0930aca0b6315db45d00f76fa0052d841eea94598d390c39d6')

# Windows targets to build. aarch64-w64-mingw32 is experimental (see README.EN.md).
_targets="${MINGW_W64_TARGETS:-i686-w64-mingw32 x86_64-w64-mingw32}"

package() {
  cd "raygui-${pkgver}"
  for _target in ${_targets}; do
    install -Dm644 src/raygui.h "${pkgdir}/usr/${_target}/include/raygui.h"
    # the default style is compiled into raygui.h; the other 19 ship a .rgs and a .h each
    for _rgs in styles/*/style_*.rgs; do
      install -Dm644 -t "${pkgdir}/usr/${_target}/share/raygui/styles/$(basename "$(dirname "${_rgs}")")" \
        "${_rgs}" "${_rgs%.rgs}.h"
    done
  done
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

